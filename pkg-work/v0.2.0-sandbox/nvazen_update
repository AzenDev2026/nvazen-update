#!/bin/sh
# =============================================================================
#  nvazen_update — the online updater for NVazen
#
#  What it does:
#    Reads the latest Release of the nvazen-update repository, downloads the
#    update package, extracts it, and follows the lead.txt instructions inside
#    the package to install everything — so a system installed from the NVazen
#    ISO keeps receiving updates forever.
#
#    It also keeps an eye on known NVazen components (DeepTerminal, NAAP, ...):
#    when one of them is missing from the system, the update automatically
#    installs the latest version and says so:
#
#        DeepTerminal not found, update = install latest version
#
#  lead.txt syntax:
#    # comment                  ignored
#    /remove old-target [path]  delete the installed old "target"
#                               (default location INSTALL_BASE/target)
#    /install new-target [path] install the new "target" from the package
#                               (default location INSTALL_BASE/target)
#    /run script [args...]      run an install script inside the package
#
#  Usage:
#    nvazen_update                  check and apply the latest update
#    nvazen_update --check          only check (exit code 100 = update
#                                   available or components missing)
#    nvazen_update --dry-run        show what would happen, change nothing
#    nvazen_update --force          re-apply even when the version matches
#    nvazen_update --package pkg    install a local package, no network
#    nvazen_update --config file    use the given config file
#
#  Exit codes:
#    0    success / already up to date
#    1    error
#    100  --check only: an update is available or components are missing
#
#  Requires: sh, curl or wget, tar, sed, find (zip packages also need unzip)
#  Optional: GH_TOKEN environment variable (raises the GitHub API limit)
# =============================================================================

VERSION="1.1.0"

# ---------- Default configuration (config file / env vars override) ----------
REPO_OWNER="AzenDev2026"
REPO_NAME="nvazen-update"
API_BASE=""
INSTALL_BASE="/opt/nvazen"
# Known components, as "DisplayName:relative/path" pairs (path is relative to
# INSTALL_BASE, or absolute). A missing component is detected and the update
# re-installs it. Add more pairs as more components ship in update packages.
COMPONENTS="DeepTerminal:deepterminal"
STATE_DIR=""
STATE_FILE=""
CONFIG_FILE=""
PKG_FILE=""
GH_TOKEN=""
UA="nvazen_update/$VERSION"
DRY_RUN=0
FORCE=0
CHECK_ONLY=0
VERBOSE=0
KEEP_WORK=0
WORK=""
PKG=""
ASSET_URL=""
TAG=""
EXTRACT_DIR=""
pkg_root=""
LN=0
MISSING_NAMES=""
MISSING_COUNT=0

# ---------- Output helpers ----------
info()    { printf '%s\n' "[nvazen_update] $*"; }
warn()    { printf '%s\n' "[nvazen_update] warning: $*" >&2; }
error()   { printf '%s\n' "[nvazen_update] error: $*" >&2; }
verbose() { [ "$VERBOSE" -ge 1 ] && printf '%s\n' "[nvazen_update] $*"; }

die() {
    KEEP_WORK=1
    error "$*"
    if [ -n "$WORK" ] && [ -d "$WORK" ]; then
        printf '%s\n' "[nvazen_update] the failed run was kept for debugging: $WORK" >&2
    fi
    exit 1
}

usage() {
    cat <<'EOF'
Usage: nvazen_update [options]

Options:
  --check              Only check for an update (no download, no install).
                       Exit code 100 = an update is available OR a known
                       component (e.g. DeepTerminal) is missing.
  --dry-run, -n        Show what would happen without changing anything.
  --force, -f          Re-apply the latest version even when it is current.
  --package <file>     Install a local update package instead of the network
                       (testing only).
  --config <file>      Use the given config file (default /etc/nvazen-update.conf).
  --keep               Keep the temporary work directory (debugging).
  --verbose, -v        Print extra details.
  --version            Show the version number.
  --help, -h           Show this help.

Config file (optional) supports these keys:
  REPO_OWNER=xxx  REPO_NAME=xxx  INSTALL_BASE=xxx  STATE_DIR=xxx
  COMPONENTS="Name:path Name:path ..."

Environment variables (highest priority):
  NVZ_REPO_OWNER / NVZ_REPO_NAME / NVZ_INSTALL_BASE / NVZ_STATE_DIR /
  NVZ_COMPONENTS / NVZ_GH_TOKEN

Exit codes: 0 success or already current; 1 error; 100 --check found something to do.
EOF
}

# ---------- Argument parsing ----------
parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)    usage; exit 0 ;;
            --version)    echo "nvazen_update $VERSION"; exit 0 ;;
            -n|--dry-run) DRY_RUN=1 ;;
            -f|--force)   FORCE=1 ;;
            --check)      CHECK_ONLY=1 ;;
            -v|--verbose) VERBOSE=1 ;;
            --keep)       KEEP_WORK=1 ;;
            --config)
                [ $# -ge 2 ] || die "--config needs an argument"
                CONFIG_FILE="$2"; shift ;;
            --package)
                [ $# -ge 2 ] || die "--package needs an argument"
                PKG_FILE="$2"; shift ;;
            *) die "unknown option: $1 (use --help for usage)" ;;
        esac
        shift
    done
}

# ---------- Config file ----------
load_config() {
    _f="$1"
    [ -n "$_f" ] && [ -f "$_f" ] || return 0
    while IFS='=' read -r _k _v; do
        _k=$(printf '%s' "$_k" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | tr -d '\r')
        _v=$(printf '%s' "$_v" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | tr -d '\r')
        case "$_k" in
            '#'*|'') continue ;;
            REPO_OWNER)   REPO_OWNER=$_v ;;
            REPO_NAME)    REPO_NAME=$_v ;;
            INSTALL_BASE) INSTALL_BASE=$_v ;;
            STATE_DIR)    STATE_DIR=$_v ;;
            COMPONENTS)   COMPONENTS=$_v ;;
        esac
    done < "$_f"
}

apply_env_overrides() {
    [ -n "${NVZ_REPO_OWNER:-}" ]   && REPO_OWNER="$NVZ_REPO_OWNER"
    [ -n "${NVZ_REPO_NAME:-}" ]    && REPO_NAME="$NVZ_REPO_NAME"
    [ -n "${NVZ_INSTALL_BASE:-}" ] && INSTALL_BASE="$NVZ_INSTALL_BASE"
    [ -n "${NVZ_STATE_DIR:-}" ]    && STATE_DIR="$NVZ_STATE_DIR"
    [ -n "${NVZ_COMPONENTS:-}" ]   && COMPONENTS="$NVZ_COMPONENTS"
    [ -n "${NVZ_GH_TOKEN:-}" ]     && GH_TOKEN="$NVZ_GH_TOKEN"
}

validate_base() {
    case "$INSTALL_BASE" in
        ""|"/") die "INSTALL_BASE is not a valid path: $INSTALL_BASE" ;;
    esac
}

pick_state() {
    if [ -z "$STATE_DIR" ]; then
        if [ "$(id -u 2>/dev/null)" = "0" ]; then
            STATE_DIR="/var/lib/nvazen-update"
        else
            STATE_DIR="${HOME:-/tmp}/.local/share/nvazen-update"
        fi
    fi
    STATE_FILE="$STATE_DIR/current_version"
}

# ---------- Component registry ----------
component_path() {
    _rel="${1:-}"
    case "$_rel" in
        /*) printf '%s\n' "$_rel" ;;
        *)  printf '%s\n' "$INSTALL_BASE/$_rel" ;;
    esac
}

component_label() {
    # Display name for a target ("deepterminal" -> "DeepTerminal").
    _target="$1"
    for _entry in $COMPONENTS; do
        _name=${_entry%%:*}
        _rel=${_entry#*:}
        _rel=${_rel%%:*}
        if [ "$_rel" = "$_target" ]; then
            printf '%s\n' "$_name"
            return 0
        fi
    done
    printf '%s\n' "$_target"
}

check_components() {
    MISSING_NAMES=""
    MISSING_COUNT=0
    [ -n "$COMPONENTS" ] || return 0
    for _entry in $COMPONENTS; do
        _name=${_entry%%:*}
        _rest=${_entry#*:}
        [ "$_rest" = "$_entry" ] && continue
        _rel=${_rest%%:*}
        _path=$(component_path "$_rel")
        if [ ! -e "$_path" ] && [ ! -L "$_path" ]; then
            MISSING_COUNT=$((MISSING_COUNT + 1))
            MISSING_NAMES="${MISSING_NAMES}${MISSING_NAMES:+ }$_name"
        fi
    done
    if [ "$MISSING_COUNT" -gt 0 ]; then
        for _name in $MISSING_NAMES; do
            info "$_name not found, update = install latest version"
        done
    fi
}

# ---------- Network ----------
http_get() {
    _url="$1"; _out="$2"
    if command -v curl >/dev/null 2>&1; then
        if [ -n "$GH_TOKEN" ]; then
            curl -fsL -A "$UA" -H "Authorization: Bearer $GH_TOKEN" -o "$_out" "$_url"
        else
            curl -fsL -A "$UA" -o "$_out" "$_url"
        fi
    elif command -v wget >/dev/null 2>&1; then
        if [ -n "$GH_TOKEN" ]; then
            wget -q -U "$UA" --header="Authorization: Bearer $GH_TOKEN" -O "$_out" "$_url"
        else
            wget -q -U "$UA" -O "$_out" "$_url"
        fi
    else
        return 1
    fi
}

http_status() {
    _url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -s -o /dev/null -w '%{http_code}' -A "$UA" "$_url"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --server-response -O /dev/null "$_url" 2>&1 \
            | sed -n 's/^.*HTTP\/[0-9.]* \([0-9][0-9]*\).*/\1/p' | tail -n 1
    else
        echo 000
    fi
}

# ---------- JSON parsing (jq if available, sed fallback otherwise) ----------
json_field() {
    _f="$1"; _k="$2"
    if command -v jq >/dev/null 2>&1; then
        jq -r ".$_k // empty" "$_f" 2>/dev/null
    else
        sed -n "s/.*\"$_k\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$_f" | head -n 1
    fi
}

pick_asset() {
    if command -v jq >/dev/null 2>&1; then
        _list=$(jq -r '.assets[]?.browser_download_url // empty' "$WORK/latest.json" 2>/dev/null)
    else
        _list=$(sed -n 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^\"]*\)".*/\1/p' "$WORK/latest.json")
    fi
    printf '%s\n' "$_list" | while IFS= read -r _u; do
        case "$_u" in
            *.zip|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar)
                printf '%s\n' "$_u"
                break
                ;;
        esac
    done
}

# ---------- Release fetching ----------
fetch_release() {
    info "Checking the latest Release: ${REPO_OWNER}/${REPO_NAME} ..."
    if ! http_get "$API_BASE/releases/latest" "$WORK/latest.json"; then
        _code=$(http_status "$API_BASE/releases/latest")
        case "$_code" in
            404) die "the repo ${REPO_OWNER}/${REPO_NAME} has no Release yet — publish the first one" ;;
            403|429) die "GitHub API limit reached (HTTP $_code): without a token the limit is 60/hour, set GH_TOKEN to raise it" ;;
            *) die "cannot reach GitHub (HTTP $_code), check the network connection" ;;
        esac
    fi
    TAG=$(json_field "$WORK/latest.json" tag_name)
    [ -n "$TAG" ] || die "cannot read the version (tag_name) from the Release info"
    ASSET_URL=$(pick_asset)
    if [ -z "$ASSET_URL" ]; then
        ASSET_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/archive/refs/tags/${TAG}.tar.gz"
        verbose "no archive attached to the Release, falling back to the tag source tarball: $ASSET_URL"
    fi
}

download_pkg() {
    case "$ASSET_URL" in
        *.zip)            PKG="$WORK/update.zip" ;;
        *.tar.gz|*.tgz)   PKG="$WORK/update.tar.gz" ;;
        *.tar.xz|*.txz)   PKG="$WORK/update.tar.xz" ;;
        *.tar)            PKG="$WORK/update.tar" ;;
        *)                PKG="$WORK/update.pkg" ;;
    esac
    info "Downloading the update package: $ASSET_URL"
    http_get "$ASSET_URL" "$PKG" || die "download failed, check the network connection"
}

# ---------- Extraction and checksums ----------
extract_pkg() {
    _a="$1"; _d="$2"
    mkdir -p "$_d" || die "cannot create the extraction directory: $_d"
    case "$_a" in
        *.zip)
            command -v unzip >/dev/null 2>&1 || die "the package is a zip but unzip is not installed (install unzip, or use a tar.gz package)"
            ( cd "$_d" && unzip -qo "$_a" ) || die "extraction failed: $_a" ;;
        *.tar.gz|*.tgz)
            tar -xzf "$_a" -C "$_d" || die "extraction failed: $_a" ;;
        *.tar.xz|*.txz)
            tar -xJf "$_a" -C "$_d" || die "extraction failed: $_a" ;;
        *.tar)
            tar -xf "$_a" -C "$_d" || die "extraction failed: $_a" ;;
        *)
            tar -xf "$_a" -C "$_d" 2>/dev/null || die "unsupported package format: $_a (use zip / tar.gz / tar.xz)" ;;
    esac
}

verify_checksum() {
    _d="$1"
    _sums=$(find "$_d" \( -name 'SHA256SUMS' -o -name 'SHA256SUMS.txt' -o -name 'checksums.sha256' \) -print 2>/dev/null | head -n 1)
    [ -n "$_sums" ] || return 0
    if command -v sha256sum >/dev/null 2>&1; then
        info "the package carries a checksum file, verifying..."
        _dir=$(dirname "$_sums")
        if ! ( cd "$_dir" && sha256sum -c "$(basename "$_sums")" ); then
            die "checksum verification FAILED! The package may be damaged or tampered with"
        fi
        info "checksums OK"
    else
        warn "the package carries a checksum file but sha256sum is missing, skipping verification"
    fi
}

# ---------- Permission preflight ----------
preflight() {
    [ "$DRY_RUN" -eq 1 ] && return 0
    if [ "$(id -u)" != "0" ]; then
        if ! mkdir -p "$INSTALL_BASE" 2>/dev/null || [ ! -w "$INSTALL_BASE" ]; then
            warn "the install directory $INSTALL_BASE needs root (you are not root)"
            return 1
        fi
    fi
    return 0
}

# ---------- lead.txt instruction execution ----------
sane_path() {
    case "$1" in
        ""|"/"|*".."*) return 1 ;;
    esac
    case "$1" in
        /bin|/sbin|/boot|/lib|/lib64|/etc|/var|/usr|/opt|/home|/root|/mnt|/media|/dev|/proc|/sys|/tmp) return 1 ;;
    esac
    return 0
}

do_remove() {
    _spec="${1:-}"; _path="${2:-}"
    _name=${_spec#old-}
    if [ -z "$_spec" ] || [ "$_name" = "$_spec" ]; then
        die "lead.txt line $LN is invalid: a remove target must look like old-name"
    fi
    [ -n "$_path" ] || _path="$INSTALL_BASE/$_name"
    sane_path "$_path" || die "lead.txt line $LN refuses a dangerous path: $_path"
    if [ ! -e "$_path" ] && [ ! -L "$_path" ]; then
        info "remove $_name: target does not exist, skipping ($_path)"
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        info "[dry-run] remove $_name: would delete $_path"
    else
        info "remove $_name: deleting $_path"
        rm -rf -- "$_path" || die "delete failed: $_path"
    fi
}

do_install() {
    _spec="${1:-}"; _path="${2:-}"
    _name=${_spec#new-}
    if [ -z "$_spec" ] || [ "$_name" = "$_spec" ]; then
        die "lead.txt line $LN is invalid: an install target must look like new-name"
    fi
    _src="$pkg_root/$_name"
    if [ ! -e "$_src" ] && [ ! -L "$_src" ]; then
        die "lead.txt line $LN: the package does not contain the target \"$_name\""
    fi
    [ -n "$_path" ] || _path="$INSTALL_BASE/$_name"
    sane_path "$_path" || die "lead.txt line $LN refuses to install to a dangerous path: $_path"
    if [ ! -e "$_path" ] && [ ! -L "$_path" ]; then
        # The component is not installed: this update doubles as a fresh
        # install of its latest version.
        _label=$(component_label "$_name")
        info "$_label not found, update = install latest version"
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        info "[dry-run] install $_name: package $_name -> $_path"
        return 0
    fi
    if [ -d "$_src" ] && [ ! -L "$_src" ]; then
        mkdir -p "$_path" || die "cannot create directory: $_path"
        cp -a "$_src"/. "$_path"/ || die "install failed: $_name -> $_path"
    else
        _parent=$(dirname "$_path")
        mkdir -p "$_parent" || die "cannot create directory: $_parent"
        cp -a "$_src" "$_path" || die "install failed: $_name -> $_path"
    fi
    info "install $_name: installed to $_path"
}

do_run() {
    _script="${1:-}"
    [ -n "$_script" ] || die "lead.txt line $LN is invalid: run needs a script name"
    _s="$pkg_root/$_script"
    [ -f "$_s" ] || die "lead.txt line $LN: the package does not contain the script \"$_script\""
    shift
    _run_args=""
    [ $# -gt 0 ] && _run_args="$*"
    if [ "$DRY_RUN" -eq 1 ]; then
        info "[dry-run] run $_script $_run_args"
        return 0
    fi
    info "run $_script $_run_args"
    ( cd "$pkg_root" && sh "$_script" "$@" ) || die "lead.txt line $LN: the script $_script failed"
}

apply() {
    _root="$1"
    _lead=$(find "$_root" -name lead.txt -print 2>/dev/null | head -n 1)
    [ -n "$_lead" ] || die "the package does not contain lead.txt"
    pkg_root=$(dirname "$_lead")
    info "Reading the install instructions: $_lead"
    set -f
    LN=0
    while IFS= read -r _raw || [ -n "$_raw" ]; do
        LN=$((LN + 1))
        _line=$(printf '%s\n' "$_raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -z "$_line" ] && continue
        case "$_line" in
            '#'*) continue ;;
            /*) ;;
            *) die "lead.txt line $LN is not recognised (# starts a comment, / starts an instruction): $_raw" ;;
        esac
        set -- $_line
        _cmd="$1"; shift
        case "$_cmd" in
            /remove)  do_remove "$@" ;;
            /install) do_install "$@" ;;
            /run)     do_run "$@" ;;
            *) die "lead.txt line $LN has an unknown instruction: $_cmd" ;;
        esac
    done < "$_lead"
    set +f
}

# ---------- State ----------
write_state() {
    if mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$TAG" > "$STATE_FILE" 2>/dev/null; then
        info "Recorded the installed version: $TAG ($STATE_FILE)"
    else
        warn "cannot write the state file $STATE_FILE (permissions?) — the next run will see this version as new again"
    fi
}

# ---------- Temporary directory ----------
make_workdir() {
    if command -v mktemp >/dev/null 2>&1; then
        WORK=$(mktemp -d "${TMPDIR:-/tmp}/nvazen-update.XXXXXX") || die "cannot create a temporary directory"
    else
        WORK="${TMPDIR:-/tmp}/nvazen-update.$$"
        rm -rf "$WORK"
        mkdir -p "$WORK" || die "cannot create a temporary directory: $WORK"
    fi
}

cleanup() {
    if [ -n "$WORK" ] && [ -d "$WORK" ] && [ "$KEEP_WORK" -eq 0 ]; then
        rm -rf "$WORK"
    fi
}

# ---------- Main flow ----------
main() {
    parse_args "$@"
    load_config "${CONFIG_FILE:-/etc/nvazen-update.conf}"
    apply_env_overrides
    API_BASE="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}"
    validate_base
    pick_state

    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        die "neither curl nor wget is installed — cannot download updates"
    fi

    make_workdir
    trap cleanup 0 1 2 15

    if [ -n "$PKG_FILE" ]; then
        [ "$CHECK_ONLY" -eq 1 ] && verbose "--check was given together with --package; --check is ignored"
        case "$PKG_FILE" in
            /*) ;;
            *) PKG_FILE="$(pwd)/$PKG_FILE" ;;
        esac
        [ -f "$PKG_FILE" ] || die "cannot find the local package: $PKG_FILE"
        TAG="local"
        info "Using the local package: $PKG_FILE (network and version checks skipped)"
        EXTRACT_DIR="$WORK/extract"
        extract_pkg "$PKG_FILE" "$EXTRACT_DIR"
    else
        fetch_release
        CUR=$(cat "$STATE_FILE" 2>/dev/null || true)
        check_components
        if [ "$CHECK_ONLY" -eq 1 ]; then
            if [ "$CUR" = "$TAG" ] && [ "$MISSING_COUNT" -eq 0 ]; then
                info "Already up to date: $TAG"
                exit 0
            fi
            if [ "$CUR" != "$TAG" ]; then
                info "New version available: $TAG (installed: ${CUR:-none})"
            else
                info "Version $TAG is current, but $MISSING_COUNT component(s) are missing — the update will reinstall them"
            fi
            exit 100
        fi
        if [ "$CUR" = "$TAG" ] && [ "$FORCE" -eq 0 ] && [ "$MISSING_COUNT" -eq 0 ]; then
            info "Already up to date ($TAG) — nothing to do (--force re-applies)"
            exit 0
        fi
        if [ "$CUR" = "$TAG" ] && [ "$MISSING_COUNT" -gt 0 ]; then
            info "Version is current but components are missing — re-applying to restore them"
        fi
        [ -n "$CUR" ] && info "Installed version: $CUR"
        info "Updating to: $TAG"
        download_pkg
        EXTRACT_DIR="$WORK/extract"
        extract_pkg "$PKG" "$EXTRACT_DIR"
    fi

    verify_checksum "$EXTRACT_DIR"
    preflight || die "no write access to the install directory, run: sudo nvazen_update"
    apply "$EXTRACT_DIR"

    if [ -z "$PKG_FILE" ]; then
        write_state
    else
        verbose "local package mode: the version state is not recorded"
    fi
    info "Update complete! NVazen is now at ${TAG}"
}

main "$@"
